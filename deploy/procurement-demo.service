[Unit]
Description=AI Procurement Assistant Streamlit Demo
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/recommend-demo
EnvironmentFile=/etc/procurement-demo.env
ExecStart=/home/ubuntu/recommend-demo/.venv/bin/python -m streamlit run app.py --server.port 8501 --server.address 127.0.0.1 --server.headless true --browser.gatherUsageStats false
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
